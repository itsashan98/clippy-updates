        <item>
            <title>1.1.4</title>
            <pubDate>Wed, 28 Oct 2026 08:31:49 +0530</pubDate>
            <sparkle:version>6</sparkle:version>
            <sparkle:shortVersionString>1.1.4</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>Clippy now saves only the links you copy. To save everything you copy, turn on Settings ▸ Clipboard ▸ Save everything I copy. You can also select several clips, or Select All, and delete them together.</p>
]]></description>
